# env.example缺的環境變數如下：
# DB_PASSWORD、JWT_SECRET

# ==============================
# Express Server
# ==============================

# server host & port
SERVER_HOST=127.0.0.1
SERVER_PORT=3000 

# ==============================
# MySQL Connection
# ==============================

# Express 現在直接執行於 Ubuntu 本機，因此要連線 Docker 映射到本機的 port。
DB_HOST=127.0.0.1
DB_PORT=3306

# 與根目錄.env的MYSQL_DATABASE值要相同
DB_NAME=jianghu_task_manager

# 與根目錄.env的MYSQL_USER值要相同
DB_USER=jianghu_app

# 與根目錄.env的MYSQL_PASSWORD值要相同
DB_PASSWORD=


# ==============================
# JWT Authentication
# ==============================

# JWT 簽章與驗證使用的 Secret
#
# 注意：
# 需先安裝 Node.js 環境，然後使用以下指令產生隨機 JWT_SECRET
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# JWT_SECRET 設定後需固定使用！因為已簽發的 JWT 會依賴此 Secret 進行驗證，
# 若更換 JWT_SECRET，舊的使用者 Token 將無法通過驗證，將導致使用者全部得重新登入。
JWT_SECRET=


# ========================================
# Access Token
# ========================================

# Access Token 的有效期限。
#
# Access Token 為短效 Token，
# 過期後無法繼續存取需要身份驗證的 API。
#
# 前端應透過 HttpOnly Cookie 中的 Refresh Token
# 向 /auth/refresh 取得新的 Access Token，
# 使用者通常不需要重新登入。
#
# 格式依 jsonwebtoken 的 expiresIn 規則，
# 例如：
#   15m = 15 分鐘
#   30m = 30 分鐘
#   1h  = 1 小時
ACCESS_TOKEN_EXPIRES_IN=15m


# ========================================
# Refresh Token / Session
# ========================================

# Refresh Session 的有效期限。
#
# V1 使用固定的 Refresh Token，
# 在 Session 有效期間不進行 Rotation。
#
# Refresh Token 過期後，
# 使用者需要重新登入取得新的 Refresh Token。
#
# 例如：
#   7d  = 7 天
#   30d = 30 天
#   90d = 90 天
REFRESH_TOKEN_EXPIRES_IN=30d
